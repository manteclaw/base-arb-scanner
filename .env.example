# Copy to .env and fill in. Never commit a real .env.
# The public Base RPC works with no key; set BASE_RPC_URL to your own
# provider (e.g. Alchemy) if you want higher rate limits.

BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=
MIN_PROFIT_BPS=15
MAX_GAS_GWEI=5
LOG_LEVEL=INFO

# Optional: address to watch for incoming transfers / governance in
# event_monitor.py. Leave blank to watch contracts only.
WATCH_ADDRESS=

# Optional: Discord webhook for event alerts (--alert-discord).
DISCORD_WEBHOOK_URL=

# Optional, only for event_monitor.py --live auto-execution.
# Leave unset for detect-only mode (the default).
# PRIVATE_KEY=
